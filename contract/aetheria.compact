pragma language_version >= 0.23;

import CompactStandardLibrary;

// aetheria — shielded matching + solvency. draft surface.

export ledger orderTree: MerkleTree<32, Bytes<32>>;
export ledger spent: Set<Bytes<32>>;
export ledger fills: Counter;
export ledger solvencyOk: Boolean;
export ledger solvencyEpoch: Counter;
export ledger requiredRatioBps: Uint<32>;

witness ownerSk(): Bytes<32>;
witness orderPreimage(): Vector<4, Field>;   // side, price, size, expiry
witness aggCollateral(): Field;
witness aggDebt(): Field;

circuit orderCommit(pre: Vector<4, Field>, sk: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "aeth:ord:1"), sk, salt]
  );
}

constructor(ratioBps: Uint<32>) {
  requiredRatioBps = disclose(ratioBps);
  solvencyOk = true;
}

// commit an order. the ledger learns that an order exists. nothing else.
export circuit placeOrder(commit: Bytes<32>): [] {
  orderTree.insert(disclose(commit));
}

// prove aggregate collateral covers aggregate debt at the required ratio,
// without opening either aggregate.
export circuit proveSolvency(epoch: Uint<32>): [] {
  const c = aggCollateral();
  const d = aggDebt();
  assert(c * 10000 >= d * (requiredRatioBps as Field), "insolvent");
  solvencyOk = true;
  solvencyEpoch.increment(1);
}

pragma language_version >= 0.16;

import CompactStandardLibrary;

// aetheria — shielded order commitments + continuous solvency proof.
// scoped-down v0 surface: placeOrder inserts a commitment, proveSolvency
// asserts a witness-held collateral value covers a witness-held debt value
// at a public ratio, disclosing only a boolean + epoch counter.

export ledger orders: Set<Bytes<32>>;
export ledger orderCount: Counter;
export ledger requiredRatioBps: Uint<32>;
export ledger solvencyOk: Boolean;
export ledger solvencyEpoch: Counter;

witness collateralValue(): Uint<64>;
witness debtValue(): Uint<64>;

constructor(ratioBps: Uint<32>) {
  requiredRatioBps = disclose(ratioBps);
  solvencyOk = true;
}

// commit an order. the ledger learns only that an order exists.
export circuit placeOrder(commit: Bytes<32>): [] {
  assert(!orders.member(disclose(commit)), "order already committed");
  orders.insert(disclose(commit));
  orderCount.increment(1);
}

// prove witness-held collateral covers witness-held debt at the public
// required ratio, without disclosing either value.
export circuit proveSolvency(): [] {
  const collateral = collateralValue();
  const debt = debtValue();
  const ok = collateral * 10000 >= debt * (requiredRatioBps as Uint<64>);
  assert(ok, "insolvent");
  solvencyOk = disclose(ok);
  solvencyEpoch.increment(1);
}
